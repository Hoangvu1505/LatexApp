# ===================================================================
# CẤU HÌNH GMAIL VÀ GOOGLE SIGN-IN CHO COLLABORATIVE LATEX STUDIO
# ===================================================================

# 1. Cấu hình gửi thư mời tự động qua Gmail (Nodemailer)
# Địa chỉ Gmail người gửi của bạn (ví dụ: myapp@gmail.com)
GMAIL_USER=

# Mật khẩu ứng dụng 16 ký tự của Google (Tạo tại myaccount.google.com -> Security -> App Passwords)
# Lưu ý: Không dùng mật khẩu đăng nhập Gmail thông thường!
GMAIL_APP_PASS=

# 2. Cấu hình nút Đăng nhập Google (Google Sign-In / GIS)
# Lấy từ Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=

# 3. Cổng server (mặc định 3001)
PORT=3001

